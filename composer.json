{
    "name": "filiprigoir/pswkey",
    "description": "A deterministic base converter using shuffled alphabets derived from salt and optional pepper, with streamkey and one-time-pad support.",
    "keywords": [
        "php", 
        "base",
        "converter",
        "deterministic",
        "transport key",
        "pepper",
        "salt",
        "one-time-pad",
        "stream key",
        "shuffle",
        "charset",
        "encoding",
        "decoding",
        "derivation",
        "derived key"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Filip Rigoir",
            "homepage": "https://www.pswkey.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-sodium": "*"
    },
    "suggest": {
        "ext-gmp": "Used for faster base conversions when available."
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "PswKey\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
